# ==============================================================================
# NoSQLBench Benchmark Configuration (Astra DB or open-source Cassandra)
# ==============================================================================
# Fill in the section for your target below.
# ==============================================================================

# Which cluster to benchmark: "astra" or "cassandra"
# Can be overridden per run, e.g.: TARGET=cassandra ./run_all.sh
TARGET="${TARGET:-astra}"

# --- Astra DB connection (TARGET=astra) ---

# Path to the Astra DB Secure Connect Bundle (zip file)
# Example: /Users/username/downloads/secure-connect-my-db.zip
ASTRA_SCB_PATH=""

# Astra DB Application Token (Client ID / Token)
# Typically starts with "AstraCS:..."
ASTRA_TOKEN=""

# --- Open-source Cassandra connection (TARGET=cassandra) ---
# Comma-separated contact points
CASSANDRA_HOSTS="127.0.0.1"
CASSANDRA_PORT=9042

# Local datacenter name; must match 'nodetool status' exactly
CASSANDRA_LOCALDC="datacenter1"

# Leave empty if authentication is disabled
CASSANDRA_USERNAME=""
CASSANDRA_PASSWORD=""

# --- Schema (both targets) ---
# Keyspace must already exist on the target (it is not created by run_schema.sh)
KEYSPACE="pix"

# Table name to create and test
TABLE="reflinks_tokenmeta"

# Index flavor: "sai" (Astra, Cassandra 5.0+) or "legacy" (Cassandra 4.x)
# Leave empty to default to sai on Astra and legacy on Cassandra
INDEX_TYPE=""

# Path to NoSQLBench jar or binary (defaults to ../nosqlbench/nb5.jar if empty)
NB_EXEC=""

# --- Workload Parameters ---
# Total unique keys to partition over (bounds data cardinality)
KEYCOUNT=1000000

# Rampup phase settings (populates initial dataset)
RAMPUP_CYCLES=1000000
RAMPUP_THREADS=1000

# Main phase settings
MAIN_CYCLES=1000000
MAIN_THREADS=4000
MAIN_RATE=20000

# Traffic Ratios (9:1 = 90% reads / 10% writes)
READ_RATIO=9
WRITE_RATIO=1

# Consistency levels
WRITE_CL="LOCAL_QUORUM"
READ_CL="LOCAL_QUORUM"

# --- Metrics Export Settings ---
# Directory to store exported CSV metrics (a TARGET subfolder is appended, e.g. metrics/astra)
METRICS_DIR="metrics"

# Export standard timer/counter/gauge CSV files to METRICS_DIR
REPORT_CSV=true

# Export periodic summary histogram statistics (min, mean, p50, p90, p99, max) to CSV
LOG_HISTOSTATS=true

# Interval for histogram stats snapshot (e.g. 10s, 5s, 1s)
HISTOSTATS_INTERVAL="10s"

# Record separate latency timers per operation (read vs write); adds successfor_<op> metrics
INSTRUMENT_OPS=true
